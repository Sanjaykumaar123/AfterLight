# AFTERLIGHT Backend Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Upstream Archive API Timeouts (seconds)
UPSTREAM_TIMEOUT_SEC=4.5

# Database and Cache Paths
DATABASE_PATH=backend/data/afterlight.db
CACHE_DIR=backend/data/cache

